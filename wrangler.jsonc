{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vinext-cloudflare-crm",
  "placement": {
    "mode": "smart"
  },
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "compatibility_date": "2025-10-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "upload_source_maps": true,
  "vars": {
    "AUTH_EMAIL_FROM": "noreply@dijnie.dev"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "AUTH_BASE_URL"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": [
        "noreply@dijnie.dev"
      ]
    }
  ],
  "r2_buckets": [{ "binding": "CRM_FILES", "bucket_name": "vinext-crm-private-files" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saas-admin",
      "database_id": "aebda140-470f-4ee3-8564-3bbfcb64a609",
      "preview_database_id": "aebda140-470f-4ee3-8564-3bbfcb64a609",
      "migrations_dir": "migrations/crm"
    }
  ]
}
