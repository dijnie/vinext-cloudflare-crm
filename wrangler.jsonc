{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas-admin",
  "main": "worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "vars": {
    "AUTH_EMAIL_FROM": "noreply@dijnie.dev"
  },
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "AUTH_BASE_URL"
    ]
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@dijnie.dev"]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saas-admin",
      "database_id": "aebda140-470f-4ee3-8564-3bbfcb64a609",
      "preview_database_id": "aebda140-470f-4ee3-8564-3bbfcb64a609",
      "migrations_dir": "migrations/crm"
    }
  ]
}
