{
	"name": "vinext-cloudflare-crm",
	"description": "Bilingual CRM built with Vinext, shadcn/ui, Cloudflare Workers, and D1",
	"cloudflare": {
		"label": "Vinext CRM",
		"products": [
			"Workers",
			"D1"
		],
		"categories": [],
		"docs_url": "https://developers.cloudflare.com/workers/",
		"publish": true
	},
	"dependencies": {
		"@carbon/icons-react": "11.82.0",
		"@fontsource-variable/geist": "5.3.0",
		"@hookform/resolvers": "5.2.2",
		"@js-temporal/polyfill": "0.5.1",
		"@tanstack/react-table": "8.21.3",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vinext/cloudflare": "1.0.0-beta.7",
		"better-auth": "1.7.2",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"drizzle-orm": "0.45.2",
		"lucide-react": "0.555.0",
		"radix-ui": "1.6.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"react-hook-form": "7.66.1",
		"react-server-dom-webpack": "19.2.8",
		"recharts": "3.8.0",
		"tailwind-merge": "3.4.0",
		"tailwindcss-animate": "1.0.7",
		"vinext": "1.0.0-beta.9",
		"zod": "4.1.13"
	},
	"devDependencies": {
		"@cloudflare/vite-plugin": "1.54.4",
		"@cloudflare/vitest-plugin": "1.1.4",
		"@playwright/test": "1.62.1",
		"@types/node": "24.10.1",
		"@vitejs/plugin-react": "6.1.1",
		"@vitejs/plugin-rsc": "0.5.34",
		"auth": "1.7.2",
		"autoprefixer": "10.5.4",
		"drizzle-kit": "0.31.10",
		"postcss": "8.5.28",
		"tailwindcss": "3.4.19",
		"typescript": "5.9.3",
		"vite": "8.2.2",
		"vitest": "4.1.11",
		"wrangler": "4.129.0"
	},
	"engines": {
		"node": ">=22"
	},
	"private": true,
	"type": "module",
	"allowScripts": {
		"esbuild@0.28.1": true,
		"workerd@1.20260903.1": true
	},
	"scripts": {
		"build": "vinext build",
		"cf-typegen": "wrangler types",
		"check": "npm run typecheck && npm run test:scripts && npm run test:unit && npm run test:integration && npm run build && vinext-cloudflare deploy --dry-run",
		"db:inspect:local": "node scripts/d1-migrations.mjs --target local",
		"db:inspect:preview": "node scripts/d1-migrations.mjs --target preview",
		"db:inspect:production": "node scripts/d1-migrations.mjs --target production",
		"db:migrate:local": "node scripts/d1-migrations.mjs --target local --apply",
		"db:migrate:built": "node scripts/d1-migrations.mjs --target local --built --apply",
		"db:migrate:preview": "node scripts/d1-migrations.mjs --target preview --apply",
		"db:migrate:production": "node scripts/d1-migrations.mjs --target production --apply",
		"deploy": "node scripts/deploy.mjs",
		"dev": "npm run db:migrate:local && vinext dev --port 4321",
		"e2e:dev": "npm run db:migrate:local && vinext dev",
		"preview": "npm run build && npm run start",
		"start": "npm run db:migrate:built && wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state --port 8787 --local-protocol https",
		"test": "npm run test:unit && npm run test:integration",
		"test:e2e": "playwright test",
		"test:e2e:local": "npm run build && node scripts/e2e-local.mjs",
		"test:integration": "vitest run --dir tests/integration",
		"test:unit": "vitest run --dir tests/unit",
		"test:scripts": "node --test tests/scripts/*.test.mjs",
		"typecheck": "tsc --noEmit"
	}
}
